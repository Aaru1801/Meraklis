# Meraklis — configuration. Copy to `.env`.
# The app runs fully offline with deterministic reports even if no model is set.

# ---------------------------------------------------------------------------
# Local OpenAI-compatible model endpoint.
# The model server runs LOCALLY on this device (NVIDIA Spark target). Supported
# backends — all expose an OpenAI-compatible /v1/chat/completions endpoint:
#   • NVIDIA NIM (local container)
#   • vLLM on an NVIDIA GPU
#   • TensorRT-LLM OpenAI-compatible server
#   • llama.cpp server built with CUDA
#   • LM Studio (local server)
#   • Ollama (local, serving an open model)
#
# No cloud AI provider (OpenAI / Anthropic / Gemini) is used anywhere.
# ---------------------------------------------------------------------------
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=nvidia/nemotron-3-nano-30b
MODEL_API_KEY=

# Nemotron is a reasoning model; these grounded-JSON agents need answers, not
# chain-of-thought. "none" disables the thinking channel (empty => model default).
MODEL_REASONING_EFFORT=none

# Multilingual fallback for languages the primary Nemotron model doesn't cover
# well (e.g. Punjabi, Tagalog, Tamil, Urdu, Farsi). Any local OpenAI-compatible model.
MODEL_NAME_MULTILINGUAL=gemma4:26b

# Document OCR via NVIDIA Nemotron Parse, served by vLLM as a SECOND local
# OpenAI-compatible endpoint. Leave PARSE_BASE_URL empty to disable /api/vision.
#   docker run -d --gpus all --ipc=host -p 8001:8000 \
#     -v <cache>:/root/.cache/huggingface --restart unless-stopped \
#     --entrypoint bash nvcr.io/nvidia/vllm:26.02-py3 -c \
#     "pip install timm open_clip_torch albumentations einops && \
#      vllm serve nvidia/NVIDIA-Nemotron-Parse-v1.1 --dtype bfloat16 \
#      --trust-remote-code --gpu-memory-utilization 0.15 --max-model-len 8192 --port 8000"
PARSE_BASE_URL=
PARSE_MODEL=nvidia/NVIDIA-Nemotron-Parse-v1.1

# ---------------------------------------------------------------------------
# App / API. The FastAPI backend serves the UI and runs the agents. It binds a
# DIFFERENT port than the model server (:8000) so the two never collide.
#   Run:  uvicorn --app-dir backend openhouse.api.main:app --port 8088
# ---------------------------------------------------------------------------
OPENHOUSE_API_HOST=127.0.0.1
OPENHOUSE_API_PORT=8088

# Optional: override the local RentSafeTO SQLite cache location.
# OPENHOUSE_DB_PATH=/absolute/path/to/rentsafeto.sqlite3

# Optional: override the local 3D Massing cache (built by ingest_massing).
# OPENHOUSE_MASSING_CACHE=/absolute/path/to/massing_cache.json

# Live-trace pacing (ms per agent step) so judges can watch the system act.
# Paces the *display* only, never the data. Set 0 for instant.
EDGE_STREAM_DELAY_MS=420
