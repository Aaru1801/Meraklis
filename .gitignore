# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# SQLite write-ahead artifacts (the committed .sqlite3 is the source of truth)
data/*.sqlite3-wal
data/*.sqlite3-shm

# Tenant-reported conditions are runtime/community data, not source (auto-created)
data/conditions.sqlite3

# Optional local market-listing cache exports
data/cache/

# Heavy 3D Massing source download (the small extracted data/massing_cache.json is committed)
data/_massing_src/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/
.claude/

# Large 3D massing source (.gdb / zips). The small extracted web cache in
# frontend/public/building-models.* is committed; this raw download is not.
TorontoBuildingModels/

# Self-hosted vector tiles (large; rsynced to the GX10, regenerable via ingest_pmtiles_data + tippecanoe)
frontend/public/toronto.pmtiles

# Landmark detailed 3D models (rsynced to GX10; regenerable via ingest_landmarks)
frontend/public/landmarks.json
